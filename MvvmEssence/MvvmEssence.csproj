<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>13</LangVersion>
		<Authors>Béla Bokor</Authors>
		<Company>Brain2CPU</Company>
		<Description>The essence of MVVM</Description>
		<Copyright>Copyrigth © Béla Bokor 2020 - 2025</Copyright>
		<PackageProjectUrl>https://brain2cpu.com/devtools.html</PackageProjectUrl>
		<PackageReleaseNotes></PackageReleaseNotes>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RootNamespace>Brain2CPU.MvvmEssence</RootNamespace>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>Brain2CPU.MvvmEssence.snk</AssemblyOriginatorKeyFile>
		<AssemblyVersion>2.0.0</AssemblyVersion>
		<FileVersion>2.0.0</FileVersion>
		<Version>2.0.0</Version>
		<PackageIcon>mvvm_essence_128.png</PackageIcon>
		<RepositoryUrl>https://github.com/brain2cpu/MvvmEssence</RepositoryUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Title>MVVM Essence</Title>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="mvvm_essence_128.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>
</Project>
